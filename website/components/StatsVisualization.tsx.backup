export default function StatsVisualization() {
  const [loading, setLoading] = useState(false);
  const [activeCard, setActiveCard] = useState(0);
  
  // Total number of cards to display
  const totalCards = 6;

  const goToNextCard = () => {
    setActiveCard((prev) => (prev + 1) % totalCards);
  };

  const goToPrevCard = () => {
    setActiveCard((prev) => (prev - 1 + totalCards) % totalCards);
  };

  if (loading) {
    return (
      <section className="py-12 bg-gray-50">
        <div className="max-w-6xl mx-auto">
          <h2 className="text-2xl font-bold text-center mb-8">Dataset Statistics</h2>
          <div className="text-center py-12">Loading statistics...</div>
        </div>
      </section>
    );
  }

  // Language name mapping for current data
  const languageNames = {
    XHO: 'isiXhosa',
    ZUL: 'isiZulu', 
    SOT: 'Sesotho',
    TSN: 'Setswana'
  };

  // Prepare data for current progress vs targets
  const progressData = {
    labels: Object.keys(projectScope.languages).map(code => projectScope.languages[code as keyof typeof projectScope.languages].name),
    datasets: [
      {
        label: 'Target Hours',
        data: Object.values(projectScope.languages).map(lang => lang.targetHours),
        backgroundColor: 'rgba(156, 163, 175, 0.6)',
        borderColor: 'rgba(156, 163, 175, 1)',
        borderWidth: 1,
      },
      {
        label: 'Current Hours',
        data: Object.values(projectScope.languages).map(lang => lang.currentHours),
        backgroundColor: colors.primary[0],
        borderColor: colors.primary[0].replace('0.8', '1'),
        borderWidth: 1,
      },
    ],
  };

  // Prepare data for language distribution chart (current data only)
  const languageData = {
    labels: Object.keys(realStats.languages).map(code => languageNames[code as keyof typeof languageNames]),
    datasets: [
      {
        label: 'Audio Hours',
        data: Object.values(realStats.languages).map(lang => lang.hours),
        backgroundColor: colors.primary,
        borderColor: colors.primary.map(color => color.replace('0.8', '1')),
        borderWidth: 1,
      },
      {
        label: 'Number of Clips',
        data: Object.values(realStats.languages).map(lang => lang.clips / 1000), // Scale down for better visualization
        backgroundColor: colors.secondary,
        borderColor: colors.secondary.map(color => color.replace('0.8', '1')),
        borderWidth: 1,
      },
    ],
  };

  // Prepare data for speaker demographics (gender) chart
  const totalMale = Object.values(realStats.languages).reduce((sum, lang) => sum + lang.male, 0);
  const totalFemale = Object.values(realStats.languages).reduce((sum, lang) => sum + lang.female, 0);
  
  const genderData = {
    labels: ['Male', 'Female'],
    datasets: [
      {
        data: [totalMale, totalFemale],
        backgroundColor: colors.tertiary.slice(0, 2),
        borderColor: '#ffffff',
        borderWidth: 2,
      },
    ],
  };

  // Prepare data for age group distribution
  const ageGroupTotals = {
    '18-29': 0,
    '30-39': 0,
    '40-49': 0,
    '50-59': 0,
    '60+': 0
  };

  Object.values(realStats.languages).forEach(lang => {
    Object.entries(lang.ageGroups).forEach(([age, count]) => {
      ageGroupTotals[age as keyof typeof ageGroupTotals] += count;
    });
  });

  const ageGroupData = {
    labels: Object.keys(ageGroupTotals),
    datasets: [
      {
        label: 'Speakers by Age Group',
        data: Object.values(ageGroupTotals),
        backgroundColor: 'rgba(99, 102, 241, 0.2)',
        borderColor: 'rgba(99, 102, 241, 1)',
        borderWidth: 2,
      },
    ],
  };

  // Prepare data for WER performance comparison (exclude isiNdebele since no data yet)
  const languagesWithWER = Object.entries(projectScope.languages)
    .filter(([code, lang]) => lang.zeroShotWER !== null && lang.fineTunedWER !== null);

  const werData = {
    labels: languagesWithWER.map(([code, lang]) => lang.name),
    datasets: [
      {
        label: 'Zero-Shot WER (%)',
        data: languagesWithWER.map(([code, lang]) => lang.zeroShotWER),
        backgroundColor: 'rgba(239, 68, 68, 0.6)',
        borderColor: 'rgba(239, 68, 68, 1)',
        borderWidth: 1,
      },
      {
        label: 'Fine-Tuned WER (%)',
        data: languagesWithWER.map(([code, lang]) => lang.fineTunedWER),
        backgroundColor: 'rgba(34, 197, 94, 0.6)',
        borderColor: 'rgba(34, 197, 94, 1)',
        borderWidth: 1,
      },
    ],
  };

  // Options for bar chart
  const barOptions = {
    responsive: true,
    plugins: {
      legend: {
        position: 'top' as const,
      },
      title: {
        display: true,
        text: 'Language Distribution (Hours)',
      },
    },
    scales: {
      y: {
        beginAtZero: true,
      },
    },
  };

  // Options for progress chart
  const progressOptions = {
    responsive: true,
    plugins: {
      legend: {
        position: 'top' as const,
      },
      title: {
        display: true,
        text: 'Project Progress: Current vs Target Hours',
      },
    },
    scales: {
      y: {
        beginAtZero: true,
        max: 600,
      },
    },
  };

  // Options for WER performance chart
  const werOptions = {
    responsive: true,
    plugins: {
      legend: {
        position: 'top' as const,
      },
      title: {
        display: true,
        text: 'ASR Performance: Word Error Rate (WER) - Lower is Better',
      },
    },
    scales: {
      y: {
        beginAtZero: true,
        max: 250,
        ticks: {
          callback: function(value: any) {
            return value + '%';
          }
        },
      },
    },
  };

  // Options for radar chart
  const radarOptions = {
    responsive: true,
    scales: {
      r: {
        beginAtZero: true,
        max: 100,
        ticks: {
          stepSize: 20,
        },
      },
    },
    plugins: {
      legend: {
        position: 'top' as const,
      },
      title: {
        display: true,
        text: 'Age Group Distribution by Language',
      },
    },
  };

  // Options for doughnut chart
  const doughnutOptions = {
    responsive: true,
    plugins: {
      legend: {
        position: 'right' as const,
      },
      title: {
        display: true,
        text: 'Speaker Demographics',
      },
    },
  };

  return (
    <section className="py-12 bg-gray-50">
      <div className="max-w-6xl mx-auto">
        <h2 className="text-2xl font-bold text-center mb-8">Dataset Statistics</h2>
        
        <div className="w-full max-w-4xl mx-auto">
          <Carousel>
            {/* Card 0: Project Progress Chart */}
            <Card className="w-full">
              <CardHeader>
                <CardTitle>Project Progress Overview</CardTitle>
                <CardDescription>Current data collection progress vs target hours for all 7 languages</CardDescription>
              </CardHeader>
              <CardContent className="h-96">
                <Bar data={progressData} options={progressOptions} />
              </CardContent>
            </Card>

            {/* Card 1: Language Distribution Chart */}
            <Card className="w-full">
              <CardHeader>
                <CardTitle>Current Data Distribution</CardTitle>
                <CardDescription>Audio hours and clips for languages with available data</CardDescription>
              </CardHeader>
              <CardContent className="h-96">
                <Bar data={languageData} options={barOptions} />
              </CardContent>
            </Card>

            {/* Card 2: ASR Performance Chart */}
            <Card className="w-full">
              <CardHeader>
                <CardTitle>ASR Model Performance</CardTitle>
                <CardDescription>Word Error Rate comparison: Zero-shot vs Fine-tuned models (lower WER is better)</CardDescription>
              </CardHeader>
              <CardContent className="h-96">
                <Bar data={werData} options={werOptions} />
              </CardContent>
            </Card>

            {/* Card 3: Age Group Distribution Chart */}
            <Card className="w-full">
              <CardHeader>
                <CardTitle>Age Group Distribution</CardTitle>
                <CardDescription>Speaker distribution across age groups</CardDescription>
              </CardHeader>
              <CardContent className="h-96">
                <Radar data={ageGroupData} options={radarOptions} />
              </CardContent>
            </Card>

            {/* Card 4: Speaker Demographics Chart */}
            <Card className="w-full">
              <CardHeader>
                <CardTitle>Speaker Demographics</CardTitle>
                <CardDescription>Distribution of speakers by gender</CardDescription>
              </CardHeader>
              <CardContent className="h-96">
                <div className="flex justify-center items-center h-full">
                  <div className="w-64">
                    <Doughnut data={genderData} options={doughnutOptions} />
                  </div>
                </div>
              </CardContent>
            </Card>

            {/* Card 5: Key Statistics */}
            <Card className="w-full">
              <CardHeader>
                <CardTitle>Project Overview</CardTitle>
                <CardDescription>Current progress and complete project scope</CardDescription>
              </CardHeader>
              <CardContent className="h-96">
                <div className="grid grid-cols-2 gap-4">
                  <div className="bg-indigo-50 rounded-lg p-4">
                    <h3 className="text-sm text-indigo-800 font-medium mb-1">Current Audio</h3>
                    <p className="text-3xl font-bold text-indigo-600">
                      {Object.values(realStats.languages).reduce((sum, lang) => sum + lang.hours, 0).toFixed(1)} hours
                    </p>
                    <p className="text-xs text-indigo-600 mt-1">
                      / {Object.values(projectScope.languages).reduce((sum, lang) => sum + lang.targetHours, 0)} target
                    </p>
                  </div>
                  <div className="bg-pink-50 rounded-lg p-4">
                    <h3 className="text-sm text-pink-800 font-medium mb-1">Current Clips</h3>
                    <p className="text-3xl font-bold text-pink-600">
                      {Object.values(realStats.languages).reduce((sum, lang) => sum + lang.clips, 0).toLocaleString()}
                    </p>
                  </div>
                  <div className="bg-green-50 rounded-lg p-4">
                    <h3 className="text-sm text-green-800 font-medium mb-1">Current Speakers</h3>
                    <p className="text-3xl font-bold text-green-600">
                      {Object.values(realStats.languages).reduce((sum, lang) => sum + lang.speakers, 0)}
                    </p>
                  </div>
                  <div className="bg-violet-50 rounded-lg p-4">
                    <h3 className="text-sm text-violet-800 font-medium mb-1">Total Languages</h3>
                    <p className="text-3xl font-bold text-violet-600">{Object.keys(projectScope.languages).length}</p>
                    <p className="text-xs text-violet-600 mt-1">
                      {Object.values(projectScope.languages).filter(lang => lang.progress === '100%').length} completed
                    </p>
                  </div>
                </div>
              </CardContent>
            </Card>
          </Carousel>
        </div>

        {/* <p className="text-center text-sm text-gray-500 mt-8">
          Last updated: {new Date(stats.timeline.lastUpdated).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </p> */}
      </div>
    </section>
  );
}
